<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F8F8F6">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="600dp" android:gravity="center_vertical" android:orientation="vertical" android:padding="32dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pause and reflect" android:textColor="#1A1A1A" android:textSize="30sp" android:textStyle="bold"/><TextView android:id="@+id/content_filter_domain" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#757575" android:textSize="14sp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="What were you hoping to find, and what would help you more right now?" android:textColor="#1A1A1A" android:textSize="18sp"/>
  <EditText android:id="@+id/content_filter_reflection_input" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="20dp" android:background="@android:drawable/edit_text" android:gravity="top|start" android:hint="Write at least 100 characters…" android:inputType="textCapSentences|textMultiLine" android:padding="16dp" android:textColor="#1A1A1A" android:textColorHint="#757575" android:textSize="16sp"/><TextView android:id="@+id/content_filter_character_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="0 / 100" android:textColor="#757575" android:layout_marginTop="8dp"/><TextView android:id="@+id/content_filter_save_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#B3261E" android:visibility="gone"/><Button android:id="@+id/content_filter_save_btn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="Save reflection" android:textAllCaps="false"/>
 </LinearLayout>
</ScrollView>
